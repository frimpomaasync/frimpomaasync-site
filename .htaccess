# Clean URLs for frimpomaasync.com. Lives in the GitHub repo, auto-deployed.
Options -MultiViews
RewriteEngine On

# NanaOS app folder: leave every URL exactly as-is
RewriteCond %{REQUEST_URI} ^/os-fad13324c3/ [NC]
RewriteRule ^ - [L]

# Retired: Som used to ship as a zip. Anyone holding that link from an older
# email lands on the app instead of a 404.
RewriteRule ^Som\.zip$ /som-app/ [R=301,L,NC]

# Renamed 2026-08-10: the demo folder followed the product name. SynKasa's live
# demo now lives at /synkasa-demo/. Old prospect links carry ?biz=&owner=&build=
# query strings, which the redirect passes through untouched.
RewriteRule ^client-catcher-demo(/.*)?$ /synkasa-demo/ [R=301,L,NC]

# Recaptured 2026-08-17. The old demo video was a recording of the app as it
# stood in July, before the 08-11 rebuild: it still said Client Catcher, carried
# the retired spelling of her name, and closed on a URL that redirects. The app
# it filmed no longer exists, so it was recaptured from the live demo rather
# than patched. The file is removed from the repo and the deploy deletes it from
# the server, so this rule is what keeps any old direct link working.
RewriteRule ^synkasa-demo/client-catcher-demo-run\.mp4$ /synkasa-demo/synkasa-demo-run.mp4 [R=301,L,NC]

# Retired pages (2026-07 one-ladder rebuild): everything the Client Catcher and
# the old catalog pages used to say now lives on /synkasa. Files stay in the
# repo (the FTPS deploy deletes removed files); these rules retire the URLs.
RewriteRule ^client-catcher(\.html)?/?$ /synkasa [R=301,L,NC]
RewriteRule ^services(\.html)?/?$ /synkasa [R=301,L,NC]
RewriteRule ^products(\.html)?/?$ /synkasa [R=301,L,NC]
RewriteRule ^solo-business-system(\.html)?/?$ /synkasa [R=301,L,NC]
RewriteRule ^ai-products(\.html)?/?$ /synkasa [R=301,L,NC]
RewriteRule ^soma(\.html)?/?$ /synkasa#soma [R=301,L,NE,NC]

# Renamed 2026-08-06: GyeSika became Soft Appeals. "GyeSika" collides with an
# active payment company (gyesika.com) and could never rank for its own name.
# These three URLs were live for under an hour, but a link may already have gone
# out by phone or email, so they redirect rather than 404.
RewriteRule ^gyesika-your-data(\.html)?/?$ /soft-appeals-data-security [R=301,L,NC]
RewriteRule ^gyesika-audit(\.html)?/?$ /soft-appeals-audit [R=301,L,NC]
RewriteRule ^gyesika(\.html)?/?$ /soft-appeals [R=301,L,NC]

# Renamed 2026-08-07: "Your patient data" became "Data & Security Practices".
# The old URL was live and linked from the offer page, so it redirects rather
# than 404s. soft-appeals-your-data.html is removed from the repo, and the FTPS
# deploy deletes it from the server, so this rule is what keeps the URL working.
RewriteRule ^soft-appeals-your-data(\.html)?/?$ /soft-appeals-data-security [R=301,L,NC]

# Renamed 2026-08-07: the sample deliverable stopped being called an audit
# months before its URL did. /soft-appeals-audit was live, indexed and linked
# from eight pages, so it redirects rather than 404s. The file is now
# soft-appeals-sample-assessment.html.
RewriteRule ^soft-appeals-audit(\.html)?/?$ /soft-appeals-sample-assessment [R=301,L,NC]

# Retired 2026-08-07: /soft-appeals-book was an unfinished calendar that told
# visitors "nothing here books anything yet", and it promised a written claim
# review during a 30-minute call, which contradicts the PHI-free intake process.
# The intake form is the front door. Anyone who would rather talk goes to the
# contact page, which is built for questions without patient information.
RewriteRule ^soft-appeals-book(\.html)?/?$ /soft-appeals-start [R=301,L,NC]

# The free shelf gate (2026-08-11). Every takeaway on /free asks for a name
# and an email on one short form, then delivers on /free-thanks.
RewriteRule ^get/([a-z-]+)/?$ /free-get.html?item=$1 [L,QSA]

# Gated 2026-08-11: the Blueprint PDF moved into /vault and is served by
# download.php after the form. The bare URL was public and linked from /free
# and the old planner flow, so it redirects to the gate rather than 404s.
RewriteRule ^automated-small-business-blueprint\.pdf$ /get/blueprint [R=301,L,NC]

# Retired 2026-08-11: the planner pages were the one old email gate (Formspree,
# and a "check your inbox" promise nothing ever sent). The new gate replaces
# them. Files are removed from the repo; these rules keep old links alive.
RewriteRule ^planner(-thanks)?(\.html)?/?$ /get/blueprint [R=301,L,NC]

# Retired 2026-08-11: /thank-you was the old Som hand-off page, orphaned since
# the som page stopped linking it. The new delivery page carries Som now.
RewriteRule ^thank-you(\.html)?/?$ /free-thanks?item=som [R=301,L,NC]

# /index.html -> /
RewriteCond %{THE_REQUEST} \s/+index\.html[\s?] [NC]
RewriteRule ^index\.html$ / [R=301,L]

# /page.html -> /page  (permanent, keeps query strings)
# 404.html is exempt: ErrorDocument must be able to serve it by its real path.
RewriteCond %{REQUEST_URI} !^/404\.html$
RewriteCond %{THE_REQUEST} \s/+([^\s?]+)\.html[\s?] [NC]
RewriteRule ^(.+)\.html$ /$1 [R=301,L]

# /page -> serve page.html  (internal, invisible)
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME}.html -f
RewriteRule ^(.+)$ $1.html [L]

# The hero loop ships as WebM as well as MP4; make sure the host labels it.
<IfModule mod_mime.c>
  AddType video/webm .webm
  AddType image/webp .webp
</IfModule>

# Custom 404. Replaces the host's generic error page, keeps visitors on the site.
ErrorDocument 404 /404.html

# Security headers, added 2026-08-17 site audit. The host already forces
# https, so HSTS just makes the browser skip the insecure hop. nosniff and
# the frame rule are free hardening; the referrer policy keeps full URLs
# from leaking to other sites while analytics still sees the domain.
<IfModule mod_headers.c>
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# Cache policy, added 2026-07-30. The site sent no Cache-Control at all, so
# browsers guessed, and iOS guessed "keep it". A page holds the list of which
# asset versions to fetch, which means a bumped ?v= inside a cached page reaches
# nobody: the 2026-07-30 layout fix shipped correctly and stayed invisible on the
# iPad that had already loaded the page once. Pages now revalidate on every
# visit, which is one cheap 304 when nothing changed.
<IfModule mod_headers.c>
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>

  # The reverse for everything a page pulls in. Each reference carries a ?v=, so
  # a change always arrives as a new URL and the old one can be held for good.
  <FilesMatch "\.(css|js|jpg|jpeg|png|svg|webp|mp4|webm|vtt|pdf|woff2?)$">
    Header set Cache-Control "public, max-age=31536000"
  </FilesMatch>
</IfModule>
