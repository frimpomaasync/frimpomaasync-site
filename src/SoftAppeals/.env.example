# Soft Appeals Recovery Command Center · configuration reference
#
# NAMES AND DESCRIPTIONS ONLY. There is not a single real value in this file
# and there must never be one. The deploy uploads whatever is committed, so a
# value written here would be a published value.
#
# The real configuration is a PHP file that returns an array, written on the
# server and never committed:
#
#     storage-private/soft-appeals/config/config.php
#
# It is listed in .gitignore, it sits behind a deny-all .htaccess proven to
# return 403 on this host, and Config::load() reads it. Environment variables
# override it, which is how the cron jobs are configured.
#
# To create it on the server, from the hPanel File Manager:
#
#     <?php
#     return [
#         'SA_APP_ENV'        => 'production',
#         'SA_DB_DSN'         => 'mysql:host=localhost;dbname=...;charset=utf8mb4',
#         'SA_DB_USER'        => '...',
#         'SA_DB_PASSWORD'    => '...',
#         'SA_SESSION_SECRET' => '...',
#         'SA_TOKEN_SECRET'   => '...',
#         'SA_IP_HMAC_SECRET' => '...',
#     ];
#
# Generate each of the three secrets separately. Never reuse one for another.


# ---------------------------------------------------------------------------
# Environment
# ---------------------------------------------------------------------------

# production | staging | testing
# Staging refuses to seed fixtures into production and enables the mail
# allowlist. Getting this wrong on staging is how a test email reaches a real
# practice.
SA_APP_ENV=

# The absolute base URL, no trailing slash. Every emailed link is built from it.
SA_APP_URL=

# Her timezone. Storage is always UTC; this is what a person reads.
SA_BUSINESS_TIMEZONE=


# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------

# A PDO DSN. MySQL in production and on staging, each with its own database.
#   mysql:host=localhost;dbname=<prefix>_softappeals;charset=utf8mb4
# The real database name carries her account prefix. It is not written here,
# because this file is committed and a reference file names nothing real.
SA_DB_DSN=
SA_DB_USER=
SA_DB_PASSWORD=


# ---------------------------------------------------------------------------
# Secrets. Three separate values, 32 characters minimum, never reused.
# The application refuses to serve a request if any one is missing or short.
# ---------------------------------------------------------------------------

# Reserved for session-bound material.
SA_SESSION_SECRET=

# Signs and digests one-time client tokens. Rotating it invalidates every
# outstanding invitation, which is the emergency lever if one ever leaks.
SA_TOKEN_SECRET=

# Digests IP addresses and user agents for the audit trail and the rate
# limiter. Rotating it resets every counter and makes old audit digests
# uncomparable, so rotate it only deliberately.
SA_IP_HMAC_SECRET=


# ---------------------------------------------------------------------------
# Mail
# ---------------------------------------------------------------------------

# The envelope sender and the reply-to. These match the addresses fs-mail.php
# already sends from.
SA_MAIL_FROM=
SA_MAIL_REPLY_TO=

# Where owner notifications go.
SA_OWNER_EMAIL=

# Comma-separated. Any recipient outside this list is REFUSED, not merely
# skipped. Set it on staging to her own address only. Leave it empty in
# production, where an empty value means unrestricted.
SA_MAIL_ALLOWLIST=


# ---------------------------------------------------------------------------
# Storage
# ---------------------------------------------------------------------------

# Absolute path for agreements, signatures, audit exports and backups.
# Empty means the default: storage-private/soft-appeals inside the repository,
# behind the deny-all. ADR-003 explains why it is not above the web root: the
# FTPS deploy sets server-dir to ./ and the FTP root already is public_html.
SA_PRIVATE_STORAGE_PATH=


# ---------------------------------------------------------------------------
# Feature flags. Every one is false in production unless it is set here.
#
# The first two follow the same rule SA_AUTO_MIGRATE uses: leave them blank and
# they are on everywhere except production, which is what lets staging be walked
# end to end while the live site stays shut. Write false to keep them shut on
# staging too, or true to open them in production once Phase 3 has been seen
# working. Section 20 of the plan asks for false in production and a blank value
# produces exactly that there.
#
# SA_PORTAL_ENABLED        the preferences page, the Recovery Room, /soft-appeals-confirmed
# SA_CLIENT_LOGIN_ENABLED  the six-digit sign-in code, for coming back later
# ---------------------------------------------------------------------------

SA_PORTAL_ENABLED=
SA_CLIENT_LOGIN_ENABLED=
SA_E_SIGN_ENABLED=false
SA_RECOVERY_FINANCE_ENABLED=false

# The scheduled jobs (Phase 8): reminders, deadline surfacing, the daily
# backup, the morning digest. Same blank rule as the two above: blank is on
# everywhere except production. Section 25 says enable cron last, so on
# production this is set to true only after the host's cron line is in
# place and every other flag has been seen working. The Desk's "Run every
# job" button does not read this flag; it is her own act.
SA_DEADLINE_CRON_ENABLED=

# Reserved. The cron entry point is command-line only and there is no web
# trigger; this exists so one can be added without a schema change.
SA_CRON_SECRET=

# The hour of her day (0 to 23, in SA_BUSINESS_TIMEZONE) after which the
# morning digest may go. One email per day, counts only. Default 6.
SA_DIGEST_HOUR=

# Shows the sticky fictional-data notice, per rule 6 in the header of
# assets/soft-appeals.css. True until real practices are in the database.
SA_DEMO_MODE=true
